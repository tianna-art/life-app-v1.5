# ---------------------------------------------------------------------------
# crincran — client environment
# Only PUBLIC values belong here. LLM API keys are NEVER placed in this file.
# ---------------------------------------------------------------------------

# Supabase project URL (Project Settings > API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/publishable key. Safe for the client: RLS restricts every row.
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional. Set to "1" to force the on-device local store (no Supabase).
# Used for offline UI work only; the shipped default is Supabase persistence.
EXPO_PUBLIC_USE_LOCAL_STORE=0

# ---------------------------------------------------------------------------
# Server side only — set with `supabase secrets set ...`, never in the app.
# See supabase/functions/.env.example
# ---------------------------------------------------------------------------
