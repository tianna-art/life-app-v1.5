# Edge Function secrets. Set these with:
#   supabase secrets set --env-file supabase/functions/.env
# They are readable only by the Edge Function runtime, never by the app.

# Which provider the LLM abstraction resolves to: anthropic | openai | mock
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5

ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Injected automatically by Supabase in deployed functions; needed for local serve.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
